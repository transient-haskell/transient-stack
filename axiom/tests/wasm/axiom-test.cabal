cabal-version: 2.4
name: axiom-test
version: 0
executable widget-test
  main-is: Widget.hs
  hs-source-dirs: ., ../../src
  other-modules: GHCJS.HPlay.View
                 GHCJS.HPlay.Cell
  build-depends: base, transformers, containers, mtl, bytestring, directory, transient, transient-universe, ghcjs-perch
  default-language: Haskell2010
  ghc-options: -no-hs-main -optl-mexec-model=reactor
  if arch(wasm32)
    cpp-options: -DBROWSER
    build-depends: ghc-experimental

executable calc-test
  main-is: Calc.hs
  hs-source-dirs: ., ../../src
